+int uv__accept2(int sockfd, struct sockaddr* saddr, socklen_t* slen) {
+  int peerfd;
+  int err;
+  socklen_t original_slen;
+
+  (void) &err;
+  assert(sockfd >= 0);
+  assert(saddr != NULL);
+  assert(slen != NULL);
+
+  original_slen = *slen;
+
+  do {
+    *slen = original_slen;
+#ifdef uv__accept4
+    peerfd = uv__accept4(sockfd, saddr, slen, SOCK_NONBLOCK|SOCK_CLOEXEC);
+#else
+    peerfd = accept(sockfd, saddr, slen);
+#endif
+  }
+  while (peerfd == -1 && errno == EINTR);
+
+  if (peerfd == -1)
+    return UV__ERR(errno);
+
+#ifndef uv__accept4
+  err = uv__cloexec(peerfd, 1);
+  if (err == 0)
+    err = uv__nonblock(peerfd, 1);
+
+  if (err != 0) {
+    uv__close(peerfd);
+    return err;
+  }
+#endif
+
+  return peerfd;
+}
