+bool TCPWrap::HasAcceptedPeerName() const {
+  return accepted_peername_len_ > 0;
+}
+
+void TCPWrap::SetAcceptedPeerName(const sockaddr* peer, size_t peerlen) {
+  if (peer == nullptr ||
+      peerlen == 0 ||
+      peerlen > sizeof(accepted_peername_)) {
+    accepted_peername_len_ = 0;
+    return;
+  }
+
+  memcpy(&accepted_peername_, peer, peerlen);
+  accepted_peername_len_ = peerlen;
+}
+
+int TCPWrap::GetAcceptedPeerName(sockaddr* peer, int* peerlen) const {
+  if (!HasAcceptedPeerName())
+    return UV_ENOTCONN;
+
+  if (*peerlen < 0 ||
+      static_cast<size_t>(*peerlen) < accepted_peername_len_) {
+    *peerlen = static_cast<int>(accepted_peername_len_);
+    return UV_ENOBUFS;
+  }
+
+  memcpy(peer, &accepted_peername_, accepted_peername_len_);
+  *peerlen = static_cast<int>(accepted_peername_len_);
+  return 0;
+}
